{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=CgShop;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Tenancy": {
    "RootDomains": [ "cgshop.com" ],
    "AdminSubdomain": "admin",
    "AllowHeaderFallback": false
  },
  "Orders": {
    "ReservationHours": 48,
    "ExpiryCheckMinutes": 10,
    "MaxReceiptBytes": 5242880
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
