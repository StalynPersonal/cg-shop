@* Diálogo genérico para confirmar una acción con nota/motivo (validar, rechazar, cancelar, enviar...). *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        @if (Message is not null)
        {
            <MudText Class="mb-3">@Message</MudText>
        }
        <MudTextField @bind-Value="_text" Label="@Label" Lines="3" Variant="Variant.Outlined" MaxLength="1000"
                      Required="Required" RequiredError="Este campo es obligatorio" AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancelar</MudButton>
        <MudButton Color="@ConfirmColor" Variant="Variant.Filled" OnClick="Confirm"
                   Disabled="@(Required && string.IsNullOrWhiteSpace(_text))">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string Label { get; set; } = "Nota";
    [Parameter] public bool Required { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "Confirmar";
    [Parameter] public Color ConfirmColor { get; set; } = Color.Primary;

    private string? _text;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(_text?.Trim() ?? ""));

    /// <summary>Muestra el diálogo y devuelve el texto ingresado, o null si se canceló.</summary>
    public static async Task<string?> AskAsync(IDialogService dialogs, string title, string label, bool required,
        string confirmText, Color color, string? message = null)
    {
        var parameters = new DialogParameters<TextPromptDialog>
        {
            { x => x.Title, title }, { x => x.Label, label }, { x => x.Required, required },
            { x => x.ConfirmText, confirmText }, { x => x.ConfirmColor, color }, { x => x.Message, message }
        };
        var dialog = await dialogs.ShowAsync<TextPromptDialog>(title, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        return result is { Canceled: false, Data: string text } ? text : null;
    }
}
