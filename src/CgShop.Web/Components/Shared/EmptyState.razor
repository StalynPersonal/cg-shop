<MudStack AlignItems="AlignItems.Center" Class="py-12 px-4" Spacing="2">
    <MudIcon Icon="@Icon" Style="font-size:4rem" Color="Color.Default" />
    <MudText Typo="Typo.h5">@Title</MudText>
    @if (Message is not null)
    {
        <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">@Message</MudText>
    }
    @ChildContent
</MudStack>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Info;
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
