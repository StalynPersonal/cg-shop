@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <SessionTimeoutGuard />
    </Authorized>
</AuthorizeView>

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIcon Icon="@Icons.Material.Filled.Hub" Class="mr-2" />
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">
            <MudText Typo="Typo.h6">CG Shop @(Host.IsAdmin ? "· Super Admin" : "")</MudText>
        </MudLink>
        @if (Host.IsAdmin)
        {
            <AuthorizeView Policy="@Policies.SuperAdmin">
                <MudButton Href="/" Color="Color.Inherit" Class="ml-6">Empresas</MudButton>
                <MudButton Href="/empresas/nueva" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AddBusiness">Nueva empresa</MudButton>
            </AuthorizeView>
        }
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-2">@context.User.FindFirst(CgClaimTypes.FullName)?.Value</MudText>
                <LogoutButton />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter] private HostContext Host { get; set; } = default!;
}
