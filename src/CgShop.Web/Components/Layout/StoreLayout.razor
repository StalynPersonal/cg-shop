@inherits LayoutComponentBase
@implements IDisposable
@inject CartState Cart

<AuthorizeView>
    <Authorized>
        <SessionTimeoutGuard />
    </Authorized>
</AuthorizeView>
<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary" Gutters="false">
        @* Mismo ancho que el contenido: logo | buscador | cuenta · carrito (como las tiendas departamentales). *@
        <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center cg-header">
            @* Menú ☰ en celular y tablet: secciones, categorías y cuenta *@
            <MudHidden Breakpoint="Breakpoint.LgAndUp">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="() => _menuOpen = true" aria-label="Menú" data-testid="store-menu" />
            </MudHidden>
            <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Class="d-flex align-center gap-2 cg-appbar-title">
                @if (Host.Tenant?.LogoUrl is { } logo)
                {
                    <img src="@logo" alt="@Host.Tenant.Name" style="height:36px" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Storefront" />
                }
                <MudText Typo="Typo.h6" Class="cg-appbar-title" data-testid="store-name">@Host.Tenant?.Name</MudText>
            </MudLink>
            @* Buscador al centro en escritorio; en celular va en su propia franja debajo. *@
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <StoreSearchBox Class="cg-header-search" />
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
                <MudSpacer />
            </MudHidden>
            @* Escritorio: cuenta con texto, separada del carrito. Celular: solo íconos. *@
            <MudHidden Breakpoint="Breakpoint.Xs">
                <div class="cg-header-actions">
                    <AuthorizeView>
                        <Authorized>
                            @if (IsStaff(context.User))
                            {
                                <MudButton Href="/admin" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Dashboard"
                                           Class="cg-header-action" data-testid="nav-admin">Panel</MudButton>
                            }
                            else
                            {
                                <MudButton Href="/mi-cuenta" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.AccountCircle"
                                           Class="cg-header-action" data-testid="nav-account">Mi cuenta</MudButton>
                            }
                            <LogoutButton IconOnly="true" />
                        </Authorized>
                        <NotAuthorized>
                            <MudButton Href="/cuenta/login" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.AccountCircle"
                                       Class="cg-header-action" data-testid="nav-login">Iniciar sesión</MudButton>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                <AuthorizeView>
                    <Authorized>
                        <MudIconButton Href="@(IsStaff(context.User) ? "/admin" : "/mi-cuenta")" Color="Color.Inherit"
                                       Icon="@(IsStaff(context.User) ? Icons.Material.Outlined.Dashboard : Icons.Material.Outlined.AccountCircle)"
                                       aria-label="Mi cuenta" />
                    </Authorized>
                    <NotAuthorized>
                        <MudIconButton Href="/cuenta/login" Color="Color.Inherit" Icon="@Icons.Material.Outlined.AccountCircle"
                                       aria-label="Iniciar sesión" />
                    </NotAuthorized>
                </AuthorizeView>
            </MudHidden>
            <MudBadge Content="@Cart.Count" Visible="@(Cart.Count > 0)" Color="Color.Secondary" Overlap="true" Class="cg-header-cart">
                <MudIconButton Href="/carrito" Icon="@Icons.Material.Outlined.ShoppingBag" Color="Color.Inherit"
                               aria-label="Carrito" />
            </MudBadge>
        </MudContainer>
    </MudAppBar>

    <MudDrawer @bind-Open="_menuOpen" Variant="DrawerVariant.Temporary" Anchor="Anchor.Start" Elevation="2"
               data-testid="store-drawer">
        <MudDrawerHeader Class="mud-theme-primary">
            <MudText Typo="Typo.h6">@Host.Tenant?.Name</MudText>
        </MudDrawerHeader>
        <MudNavMenu Color="Color.Primary">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" OnClick="Close">Inicio</MudNavLink>
            <MudNavLink Href="/catalogo" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.GridView" OnClick="Close">Todo el catálogo</MudNavLink>
            @foreach (var section in Ui.Sections)
            {
                <MudNavGroup Title="@section.DisplayName()" Icon="@SectionIcon(section)" data-testid="drawer-section">
                    <MudNavLink Href="@Ui.CatalogUrl(section, null)" Match="NavLinkMatch.All" OnClick="Close">
                        Ver todo @section.DisplayName()
                    </MudNavLink>
                    @foreach (var category in Enum.GetValues<ProductCategory>())
                    {
                        <MudNavLink Href="@Ui.CatalogUrl(section, category)" OnClick="Close">@category.DisplayName()</MudNavLink>
                    }
                </MudNavGroup>
            }
            <MudDivider Class="my-2" />
            @foreach (var category in Enum.GetValues<ProductCategory>())
            {
                <MudNavLink Href="@($"/catalogo/{Ui.CategorySlug(category)}")" Icon="@Ui.CategoryIcon(category)" OnClick="Close">
                    @category.DisplayName()
                </MudNavLink>
            }
            <MudDivider Class="my-2" />
            <MudNavLink Href="/carrito" Icon="@Icons.Material.Filled.ShoppingCart" OnClick="Close">
                Carrito @(Cart.Count > 0 ? $"({Cart.Count})" : "")
            </MudNavLink>
            <AuthorizeView>
                <Authorized>
                    @if (IsStaff(context.User))
                    {
                        <MudNavLink Href="/admin" Icon="@Icons.Material.Filled.Dashboard" OnClick="Close">Panel de la tienda</MudNavLink>
                    }
                    else
                    {
                        <MudNavLink Href="/mi-cuenta" Icon="@Icons.Material.Filled.AccountCircle" OnClick="Close">Mi cuenta y pedidos</MudNavLink>
                    }
                    <div class="px-4 py-2"><LogoutButton Color="Color.Primary" /></div>
                </Authorized>
                <NotAuthorized>
                    <MudNavLink Href="/cuenta/login" Icon="@Icons.Material.Filled.Login" OnClick="Close">Ingresar</MudNavLink>
                    <MudNavLink Href="/cuenta/registro" Icon="@Icons.Material.Filled.PersonAdd" OnClick="Close">Crear cuenta</MudNavLink>
                </NotAuthorized>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="cg-sticky-footer-layout">
        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
            <div class="cg-search-strip mud-theme-primary">
                <StoreSearchBox />
            </div>
        </MudHidden>
        @* Escritorio: barra de secciones (Mujer, Hombre, Niños con sus categorías) y categorías directas. *@
        <MudHidden Breakpoint="Breakpoint.MdAndDown">
            <nav class="cg-subnav" data-testid="store-subnav">
                <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center flex-wrap">
                    @foreach (var section in Ui.Sections)
                    {
                        <MudMenu Label="@section.DisplayName()" EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                 Variant="Variant.Text" Color="Color.Default" Class="cg-subnav-section"
                                 AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" data-testid="nav-section">
                            <MudMenuItem Href="@Ui.CatalogUrl(section, null)">
                                <b>Ver todo @section.DisplayName()</b>
                            </MudMenuItem>
                            @foreach (var category in Enum.GetValues<ProductCategory>())
                            {
                                <MudMenuItem Href="@Ui.CatalogUrl(section, category)" Icon="@Ui.CategoryIcon(category)">
                                    @category.DisplayName()
                                </MudMenuItem>
                            }
                        </MudMenu>
                    }
                    <MudDivider Vertical="true" FlexItem="true" Class="mx-2 my-2" />
                    @foreach (var category in Enum.GetValues<ProductCategory>())
                    {
                        <MudButton Href="@Ui.CatalogUrl(null, category)" Color="Color.Default" Variant="Variant.Text">
                            @category.DisplayName()
                        </MudButton>
                    }
                    <MudButton Href="/catalogo" Color="Color.Default" Variant="Variant.Text">Todo</MudButton>
                </MudContainer>
            </nav>
        </MudHidden>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6 cg-main-grow">
            @Body
        </MudContainer>
        <MudPaper Square="true" Elevation="0" Class="pa-6 mt-8 mud-theme-primary" data-testid="store-footer">
            <MudText Align="Align.Center" Typo="Typo.body2">
                © @DateTime.Now.Year @Host.Tenant?.Name · Pagos por transferencia o enlace de pago con validación manual
            </MudText>
        </MudPaper>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter] private HostContext Host { get; set; } = default!;
    private bool _menuOpen;

    private static bool IsStaff(System.Security.Claims.ClaimsPrincipal user) =>
        user.IsInRole(Roles.TenantAdmin) || user.IsInRole(Roles.TenantStaff);

    private void Close() => _menuOpen = false;

    private static string SectionIcon(ProductAudience section) => section switch
    {
        ProductAudience.Women => Icons.Material.Filled.Woman,
        ProductAudience.Men => Icons.Material.Filled.Man,
        _ => Icons.Material.Filled.ChildCare
    };

    protected override void OnInitialized() => Cart.Changed += OnCartChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Cart.EnsureLoadedAsync();
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= OnCartChanged;
}
