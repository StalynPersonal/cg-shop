@inject CatalogService Catalog
@inject CgShop.Application.Marketing.BannerService BannerService
@inject TimeProvider Clock

<PageTitle>@Host.Tenant?.Name</PageTitle>

@if (_banners.Count > 0)
{
    <HeroCarousel Banners="_banners" />
}
else
{
    <MudPaper Class="cg-hero pa-8 mb-6" Elevation="0" data-testid="default-hero">
        <MudText Typo="Typo.h3">@Host.Tenant?.Name</MudText>
        <MudText Typo="Typo.h6" Class="mt-2" Style="opacity:.9">
            Ropa, gorras, relojes, perfumes y calzados. Paga por transferencia o enlace de pago.
        </MudText>
        <MudButton Href="/catalogo" Variant="Variant.Filled" Color="Color.Secondary" Class="mt-4"
                   EndIcon="@Icons.Material.Filled.ArrowForward">Ver catálogo</MudButton>
    </MudPaper>
}

<div class="cg-category-tiles mb-8">
    @foreach (var category in Enum.GetValues<ProductCategory>())
    {
        <MudButton Href="@Ui.CatalogUrl(null, category)" StartIcon="@Ui.CategoryIcon(category)" Variant="Variant.Outlined"
                   Color="Color.Primary" Class="cg-category-tile" data-testid="category-tile">@category.DisplayName()</MudButton>
    }
</div>

<TrendingProducts Products="_trending" Currency="@Host.Currency" />

<MudText Typo="Typo.h5" Class="mb-3"><b>Novedades</b></MudText>
@if (_products is null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ProductGrid Products="_products.Items" Currency="@Host.Currency" />
}

@code {
    [CascadingParameter] private HostContext Host { get; set; } = default!;
    private PagedResult<ProductCardDto>? _products;
    private IReadOnlyList<ProductCardDto> _trending = [];
    private IReadOnlyList<CgShop.Application.Marketing.BannerDto> _banners = [];

    protected override async Task OnInitializedAsync()
    {
        _banners = await BannerService.ListActiveAsync();
        _trending = await Catalog.GetTrendingAsync(Clock.GetUtcNow().UtcDateTime);
        _products = await Catalog.SearchAsync(new CatalogQuery(PageSize: 8));
    }
}
