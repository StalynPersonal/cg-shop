@page "/mi-cuenta"
@page "/mis-pedidos"
@attribute [TenantHost]
@attribute [Authorize]
@inject CustomerOrderService CustomerOrders

<PageTitle>Mi cuenta · @Host.Tenant?.Name</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">Mi cuenta</MudText>
        <MudText Class="mud-text-secondary" data-testid="account-name">@_name · @_email @(_phone is null ? "" : $"· {_phone}")</MudText>
    </MudStack>
    <MudButton Href="/catalogo" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Storefront">
        Seguir comprando
    </MudButton>
</MudStack>

<MudText Typo="Typo.h5" Class="mb-2">Mis pedidos</MudText>

@if (_orders is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_orders.TotalCount == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.ReceiptLong" Title="Aún no tienes pedidos"
                Message="Cuando compres, verás aquí el estado de cada pedido.">
        <MudButton Href="/catalogo" Variant="Variant.Filled" Color="Color.Primary">Ver catálogo</MudButton>
    </EmptyState>
}
else
{
    <MudTable T="CustomerOrderRowDto" Items="_orders.Items" Hover="true" Dense="true" Elevation="1" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Pedido</MudTh>
            <MudTh>Fecha</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Entrega</MudTh>
            <MudTh>Total</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Pedido" data-testid="my-order-number">#@context.Number</MudTd>
            <MudTd DataLabel="Fecha">@Ui.Date(context.CreatedAtUtc)</MudTd>
            <MudTd DataLabel="Estado"><OrderStatusChip Status="context.Status" /></MudTd>
            <MudTd DataLabel="Entrega">@context.DeliveryMethod.DisplayName()</MudTd>
            <MudTd DataLabel="Total">@Ui.Money(context.Total, context.Currency)</MudTd>
            <MudTd>
                @if (context.Status == OrderStatus.PendingPaymentValidation)
                {
                    <MudButton Href="@OrderUrl(context)" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Payments">Pagar / comprobante</MudButton>
                }
                else
                {
                    <MudButton Href="@OrderUrl(context)" Size="Size.Small" Variant="Variant.Text">Ver detalle</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
    @if (_orders.TotalPages > 1)
    {
        <MudStack Row="true" Justify="Justify.Center" Class="mt-4">
            <MudPagination Count="_orders.TotalPages" Selected="_page" SelectedChanged="ChangePage" Color="Color.Primary" />
        </MudStack>
    }
}

@code {
    [CascadingParameter] private HostContext Host { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private PagedResult<CustomerOrderRowDto>? _orders;
    private string _userId = "";
    private string? _name;
    private string? _email;
    private string? _phone;
    private int _page = 1;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        var actor = user.ToActor();
        _userId = actor.UserId;
        _name = actor.DisplayName;
        _email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
        _phone = user.FindFirst(System.Security.Claims.ClaimTypes.MobilePhone)?.Value;
        await LoadAsync();
    }

    private async Task LoadAsync() => _orders = await CustomerOrders.ListMineAsync(_userId, _page, 10);

    private async Task ChangePage(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private static string OrderUrl(CustomerOrderRowDto o) => $"/pedido/{o.Number}?t={o.AccessToken}";
}
