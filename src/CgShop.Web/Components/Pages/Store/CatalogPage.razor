@page "/catalogo"
@page "/catalogo/{CategorySlug}"
@page "/seccion/{AudienceSlug}"
@page "/seccion/{AudienceSlug}/{CategorySlug}"
@attribute [TenantHost]
@inject CatalogService Catalog
@inject NavigationManager Navigation

<PageTitle>@(Title ?? "Catálogo") · @Host.Tenant?.Name</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4" data-testid="catalog-title">@(Title ?? "Todo el catálogo")</MudText>
    @* En celular los filtros se pliegan para que los productos se vean primero. *@
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@(_showFilters ? Icons.Material.Filled.Close : Icons.Material.Filled.FilterList)"
                   OnClick="() => _showFilters = !_showFilters" Class="flex-shrink-0 ml-2" data-testid="toggle-filters">
            Filtros
        </MudButton>
    </MudHidden>
</MudStack>

<MudGrid>
    <MudItem xs="12" md="3" Class="@(_showFilters ? "" : "d-none d-md-block")">
        <MudPaper Class="pa-4" Outlined="true" data-testid="catalog-filters">
            <MudStack Spacing="3">
                <MudSelect T="string" Label="Para" Value="@(_audience?.Slug() ?? "")" ValueChanged="ChangeAudience"
                           Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="audience-filter">
                    <MudSelectItem Value="@("")">Todos</MudSelectItem>
                    @foreach (var a in Ui.Sections)
                    {
                        <MudSelectItem Value="@a.Slug()">@a.DisplayName()</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Label="Categoría" Value="@(CategorySlug ?? "")" ValueChanged="ChangeCategory"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("")">Todas</MudSelectItem>
                    @foreach (var c in Enum.GetValues<ProductCategory>())
                    {
                        <MudSelectItem Value="@Ui.CategorySlug(c)">@c.DisplayName()</MudSelectItem>
                    }
                </MudSelect>
                @if (_facets is not null)
                {
                    @if (_facets.Sizes.Count > 0)
                    {
                        <MudSelect T="string" Label="@(_category == ProductCategory.Phones ? "Capacidad" : "Talla")" @bind-Value="_size" @bind-Value:after="ReloadAsync"
                                   Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var s in _facets.Sizes)
                            {
                                <MudSelectItem Value="@s">@s</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    @if (_facets.Colors.Count > 0)
                    {
                        <MudSelect T="string" Label="Color" @bind-Value="_color" @bind-Value:after="ReloadAsync"
                                   Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var c in _facets.Colors)
                            {
                                <MudSelectItem Value="@c">@c</MudSelectItem>
                            }
                        </MudSelect>
                    }
                }
                <MudSelect T="CatalogSort" Label="Ordenar por" @bind-Value="_sort" @bind-Value:after="ReloadAsync"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="CatalogSort.Newest">Más recientes</MudSelectItem>
                    <MudSelectItem Value="CatalogSort.PriceAsc">Menor precio</MudSelectItem>
                    <MudSelectItem Value="CatalogSort.PriceDesc">Mayor precio</MudSelectItem>
                    <MudSelectItem Value="CatalogSort.Name">Nombre</MudSelectItem>
                </MudSelect>
                <MudSwitch T="bool" @bind-Value="_inStock" @bind-Value:after="ReloadAsync" Color="Color.Primary"
                           Label="Solo con stock" />
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="9">
        @if (_result is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@_result.TotalCount @(_result.TotalCount == 1 ? "producto" : "productos")</MudText>
            @if (_result.TotalCount == 0)
            {
                <MudPaper Outlined="true" Class="pa-8 text-center" data-testid="catalog-empty">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6">@(_search is null ? "No hay productos con estos filtros." : $"No encontramos productos para “{_search}”.")</MudText>
                    <MudText Class="mud-text-secondary mb-4">Revisa la ortografía o prueba con otra palabra, marca o color.</MudText>
                    <MudButton Href="/catalogo" Variant="Variant.Outlined" Color="Color.Primary">Ver todo el catálogo</MudButton>
                </MudPaper>
            }
            <ProductGrid Products="_result.Items" Currency="@Host.Currency" />
            @if (_result.TotalPages > 1)
            {
                <MudStack Row="true" Justify="Justify.Center" Class="mt-6">
                    <MudPagination Count="_result.TotalPages" Selected="_page" SelectedChanged="ChangePage"
                                   Color="Color.Primary" />
                </MudStack>
            }
        }
    </MudItem>
</MudGrid>

@code {
    [CascadingParameter] private HostContext Host { get; set; } = default!;
    [Parameter] public string? CategorySlug { get; set; }
    [Parameter] public string? AudienceSlug { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    private ProductCategory? _category;
    private ProductAudience? _audience;
    private CatalogFacetsDto? _facets;
    private PagedResult<ProductCardDto>? _result;
    private string? _search;
    private string? _size;
    private string? _color;
    private bool _inStock;
    private CatalogSort _sort = CatalogSort.Newest;
    private int _page = 1;
    private bool _showFilters;

    protected override async Task OnParametersSetAsync()
    {
        _category = Ui.CategoryFromSlug(CategorySlug);
        _audience = ProductAudienceExtensions.FromSlug(AudienceSlug);
        _search = string.IsNullOrWhiteSpace(Query) ? null : Query.Trim();
        _size = _color = null;
        _page = 1;
        _facets = await Catalog.GetFacetsAsync(_category, _audience);
        await LoadAsync();
    }

    private async Task LoadAsync() =>
        _result = await Catalog.SearchAsync(new CatalogQuery(_category, _search, _size, _color, InStockOnly: _inStock,
            Sort: _sort, Page: _page, PageSize: 12, Audience: _audience));

    private async Task ReloadAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ChangePage(int page)
    {
        _page = page;
        await LoadAsync();
    }

    /// <summary>"Hombre · Calzados", "Mujer", "Relojes"...</summary>
    private string? Title => (_audience, _category) switch
    {
        (null, null) when _search is not null => $"Resultados para “{_search}”",
        (null, null) => null,
        ({ } a, null) => a.DisplayName(),
        (null, { } c) => c.DisplayName(),
        ({ } a, { } c) => $"{a.DisplayName()} · {c.DisplayName()}"
    };

    private void ChangeCategory(string slug) =>
        Navigation.NavigateTo(WithQuery(Ui.CatalogUrl(_audience, Ui.CategoryFromSlug(slug))));

    private void ChangeAudience(string slug) =>
        Navigation.NavigateTo(WithQuery(Ui.CatalogUrl(ProductAudienceExtensions.FromSlug(slug), _category)));

    private string WithQuery(string url) => _search is null ? url : $"{url}?q={Uri.EscapeDataString(_search)}";
}
