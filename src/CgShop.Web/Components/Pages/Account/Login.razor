@page "/cuenta/login"

<PageTitle>Iniciar sesión</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-6">
    <MudItem xs="12" sm="8" md="5">
        <MudPaper Class="pa-8 cg-form-card" Elevation="3">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h5">
                    @(Host.IsAdmin ? "Acceso Super Admin" : $"Iniciar sesión en {Host.Tenant?.Name}")
                </MudText>
                @if (Expirada == "1")
                {
                    <MudAlert Severity="Severity.Warning" data-testid="session-expired">
                        Tu sesión se cerró por inactividad. Vuelve a iniciar sesión.
                    </MudAlert>
                }
                @if (Error == "lockout")
                {
                    <MudAlert Severity="Severity.Error">Cuenta bloqueada temporalmente por intentos fallidos.</MudAlert>
                }
                else if (Error is not null)
                {
                    <MudAlert Severity="Severity.Error">Credenciales inválidas o el usuario no pertenece a este sitio.</MudAlert>
                }
                else if (Host.IsTenant && ReturnUrl?.StartsWith("/checkout", StringComparison.OrdinalIgnoreCase) == true)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">Inicia sesión o crea tu cuenta para completar tu compra.</MudAlert>
                }

                @* POST HTTP clásico: el inicio de sesión con cookie requiere una respuesta HTTP. *@
                <form method="post" action="/cuenta/login" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    <MudStack Spacing="3">
                        <label class="cg-field">
                            <span>Correo electrónico</span>
                            <input name="email" type="email" autocomplete="username" required />
                        </label>
                        <label class="cg-field">
                            <span>Contraseña</span>
                            <input name="password" type="password" autocomplete="current-password" required />
                        </label>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large" FullWidth="true">Entrar</MudButton>
                    </MudStack>
                </form>
                @if (Host.IsTenant)
                {
                    <MudDivider />
                    <MudText Align="Align.Center">
                        ¿No tienes cuenta?
                        <MudLink Href="@RegisterUrl" data-testid="register-link"><b>Crear cuenta</b></MudLink>
                    </MudText>
                }
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [CascadingParameter] private HostContext Host { get; set; } = default!;
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Expirada { get; set; }

    private string RegisterUrl => string.IsNullOrEmpty(ReturnUrl)
        ? "/cuenta/registro"
        : $"/cuenta/registro?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
}
