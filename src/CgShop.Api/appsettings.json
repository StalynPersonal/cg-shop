{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=CgShop;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Tenancy": {
    "RootDomains": [ "cgshop.com" ],
    "AdminSubdomain": "admin",
    "AllowHeaderFallback": true
  },
  "Jwt": {
    "Issuer": "cgshop",
    "Audience": "cgshop-api",
    "Key": "",
    "ExpirationMinutes": 120
  },
  "Jobs": {
    "Enabled": true
  },
  "Orders": {
    "ReservationHours": 48,
    "ExpiryCheckMinutes": 10,
    "MaxReceiptBytes": 5242880
  },
  "FileStorage": {
    "RootPath": "../CgShop.Web/App_Data/uploads"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
