{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=CgShop;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Tenancy": {
    "RootDomains": [
      "cgshop.com"
    ],
    "AdminSubdomain": "admin",
    "AllowHeaderFallback": true
  },
  "Jwt": {
    "Issuer": "cgshop",
    "Audience": "cgshop-api",
    "Key": "",
    "ExpirationMinutes": 120
  },
  "Jobs": {
    "Enabled": true
  },
  "FileStorage": {
    "RootPath": "../CgShop.Web/App_Data/uploads"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
